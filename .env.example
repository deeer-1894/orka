# Copy to .env and adjust. Env vars override config.yaml.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
MODEL=gpt-4o-mini
MINI_MODEL=gpt-4o-mini
VLM_MODEL=gpt-4o

MONGO_URI=mongodb://localhost:27017
MONGO_DB=orka
REDIS_ADDR=localhost:6379
BASE_STORAGE_PATH=./data/storage

GUI_AGENT_WS_URL=ws://localhost:8100/api/v1/exec/gui/ws
# Shared secret for the GUI executor WebSocket. The GUI agent drives a real
# browser, so bind it to loopback and set this token in BOTH the control layer
# and the gui_agent process. Leave empty only for isolated local dev.
GUI_AUTH_TOKEN=

# GUI planner: uitars (recommended) | vlm | rule. Default: rule (vlm when
# VLM_ENABLE=1). uitars drives the browser with a UI-TARS GUI-agent model on
# any OpenAI-compatible endpoint, e.g. vLLM serving bytedance/UI-TARS-1.5-7B;
# UITARS_* fall back to OPENAI_BASE_URL/OPENAI_API_KEY when unset.
GUI_PLANNER=rule
# UITARS_BASE_URL=http://localhost:8000/v1
# UITARS_API_KEY=
# UITARS_MODEL=ui-tars-1.5-7b
# UITARS_MAX_SHOTS=5

CHECKPOINT_TTL_SEC=86400

CORS_ALLOWED_HOSTS=localhost,127.0.0.1
# REQUIRED in non-dev: a strong random secret (>=16 chars). Startup aborts if
# this is empty or the placeholder unless ORKA_DEV=1. Must match across the
# control layer and tools_server.
CTX_TOKEN_SECRET=dev-only-change-me
CTX_TOKEN_TTL_SEC=300

# Optional premium search providers (web_search uses the first one configured,
# else falls back to keyless DuckDuckGo + Wikipedia). Configure ONE of these:
# without a key the keyless fallback is blocked or rate-limited in practice, and
# a broken web_search is expensive rather than merely absent — the agent
# improvises around it (guessing URLs, shelling out) and burns its step budget.
# These are passed into the tools container by docker-compose.tools.yml, which
# is where web_search actually runs; setting one only in .env is not enough.
#
# 豆包搜索 Custom (Volcengine), works from mainland China, 500 calls/month free:
#   https://docs.volcengine.com/docs/87772/2272953
# DOUBAO_SEARCH_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=

# ORKA_DEV=1 relaxes the secret check for local development.
LOG_LEVEL=info

# Logs the context size on both sides of the reduction pass ("ctx probe" lines),
# once per model call, so the clear threshold can be tuned against the number the
# reducer actually tests rather than provider-billed token totals. Off by
# default: the density is right for tuning and wrong for production.
# ORKA_CTX_DEBUG=1

# Models the UI may offer beyond MODEL/MINI_MODEL, comma-separated. Providers
# that host many models behind one endpoint (Ark, OpenRouter…) serve all of them
# from the same client, so only the name changes.
# MODELS=deepseek-v4-pro,kimi-k3,minimax-m3,doubao-seed-2.1-turbo
