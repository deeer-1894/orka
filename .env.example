# Copy to .env and adjust. Env vars override config.yaml.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
MODEL=gpt-4o-mini
MINI_MODEL=gpt-4o-mini
VLM_MODEL=gpt-4o

MONGO_URI=mongodb://localhost:27017
MONGO_DB=orka
REDIS_ADDR=localhost:6379
BASE_STORAGE_PATH=./data/storage

GUI_AGENT_WS_URL=ws://localhost:8100/api/v1/exec/gui/ws
# Shared secret for the GUI executor WebSocket. The GUI agent drives a real
# browser, so bind it to loopback and set this token in BOTH the control layer
# and the gui_agent process. Leave empty only for isolated local dev.
GUI_AUTH_TOKEN=
RUN_MODE=adk
CHECKPOINT_TTL_SEC=86400

CORS_ALLOWED_HOSTS=localhost,127.0.0.1
# REQUIRED in non-dev: a strong random secret (>=16 chars). Startup aborts if
# this is empty or the placeholder unless ORKA_DEV=1. Must match across the
# control layer and tools_server.
CTX_TOKEN_SECRET=dev-only-change-me
CTX_TOKEN_TTL_SEC=300

# Optional premium search providers (web_search uses the first one configured,
# else falls back to keyless DuckDuckGo + Wikipedia).
# SERPER_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=

# ORKA_DEV=1 relaxes the secret check for local development.
LOG_LEVEL=info
